{
  "name": "@routecore/harness-editor-core",
  "version": "0.3.0",
  "description": "RouteCore compatibility distribution of the authoritative @xsession/editor-core submodule.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples",
    "scripts/render-sample.mjs"
  ],
  "scripts": {
    "build": "node ../../scripts/sync-editor-core.mjs --package-only",
    "test": "npm run build && node --test test/compatibility.test.mjs",
    "check": "npm run test",
    "demo": "npm run build && node -e \"console.log('Open examples/browser/index.html through a local static server')\"",
    "render:sample": "npm run build && node scripts/render-sample.mjs"
  },
  "keywords": [
    "visual-editor",
    "diagram",
    "cad",
    "wiring-harness",
    "svg",
    "orthogonal-routing",
    "offline-first"
  ],
  "license": "GPL-2.0-only",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
